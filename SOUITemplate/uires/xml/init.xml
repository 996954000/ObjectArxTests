<?xml version="1.0" encoding="utf-8"?>
<UIDEF>
	
	<!--定义全局字体对象-->
	<font face="宋体" size="15"/>
	
	<!--定义全局string替换对象-->
	<string>
		<mainTitle value="title ver:1.0"/>
	</string>

	<!--定义全局style 控件显式属性-->
	<style>
		<class name="normalbtn" font="" colorText="#385e8b" colorTextDisable="#91a7c0" textMode="25" cursor="hand" margin-x="0"/>
		<class name="boldSongText" font="face:宋体,bold:1" checked ="1"/>	<!--不支持的属性会被静默忽略，不会报错也不会崩溃。-->
	</style>

	<!--定义全局objattr 控件默认继承属性-->
	<objattr>
		<text colorText="#385e8b" />
	</objattr>

	<!--定义全局skin对象-->
	<skin>
		<imglist name="skin_btn_round" src="IMG:btn_round_1" states="4" tile="0" vertical="0"/>
		<imgframe name="skin_btn_round_imgframe"
				  src="IMG:btn_round_1"
				  states="4" tile="0" vertical="0"
				  left="10" top="10" right="10" bottom="10"/>
		<!-- 或者用 margin-x="10" margin-y="10" 同时设置左右/上下 -->
		<button name="skin_my_btn" colorBorder="#005564" colorUp="#546315" colorDown="#CCCCCC"  colorUpHover="#FFFFFF" colorDownHover="#DDDDDD" colorUpPush="#BBBBBB" colorDownPush="#999999" colorUpDisable="#F0F0F0" colorDownDisable="#E0E0E0"/>
								<!-- 正常状态：从上到下渐变 -->		 <!-- 悬停状态 -->				<!-- 按下状态 -->					 <!-- 禁用状态 -->
		<gradation name="skin_header_bg"
           colorFrom="#4A90D9"
           colorTo="#2065B0"
           vertical="1"/>
		<!-- 0=水平渐变，1=垂直渐变 -->
	</skin>
</UIDEF>
